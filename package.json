{
  "name": "sheldon",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "26.5.0",
    "npm": "11.17.0"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run dev --workspace=@sheldon/web",
    "dev:web": "npm run dev:web --workspace=@sheldon/web",
    "test:web:standalone": "npm run test:standalone --workspace=@sheldon/web",
    "test:web:contracts": "node scripts/check-web-contracts.js",
    "test:web:backend": "npm run test:backend --workspace=@sheldon/web",
    "typecheck": "npm run typecheck --workspace=@sheldon/web",
    "typecheck:web": "npm run typecheck:standalone --workspace=@sheldon/web",
    "test:web": "npm run test --workspace=@sheldon/web && npm run test:web:backend && npm run test:web:contracts",
    "test:release": "npm run test --workspace=@sheldon/web -- --config playwright.release.config.ts",
    "build:web": "npm run build --workspace=@sheldon/web"
  }
}
